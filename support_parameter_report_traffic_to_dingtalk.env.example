# Copy this file to /etc/default/traffic-usage-dingtalk-report
# and set mode 600:
#   chmod 600 /etc/default/traffic-usage-dingtalk-report

DINGTALK_WEBHOOK='https://oapi.dingtalk.com/robot/send?access_token=REPLACE_ME'
DINGTALK_SECRET='SEC_REPLACE_ME'

TRAFFIC_INTERFACE='eth0'

# Empty limits are reported as "unlimited".
UPLOAD_LIMIT_GIB='180'
DOWNLOAD_LIMIT_GIB=''
TOTAL_LIMIT_GIB=''
