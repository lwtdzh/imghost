# For a NEW installation, copy this file to:
#   /etc/default/traffic-usage-dingtalk-report
# Set ownership and mode before adding real credentials:
#   chown root:root /etc/default/traffic-usage-dingtalk-report
#   chmod 600 /etc/default/traffic-usage-dingtalk-report
# Preserve the existing config during upgrades. This file is sourced by
# Bash as root, so use shell quoting and allow only root to edit it.
# Never commit your real access_token/secret or put them in service files.

# Enable the robot's signing option and copy its webhook and SEC... secret.
# Keep the full webhook, including the ?access_token=... query parameter.
DINGTALK_WEBHOOK='https://oapi.dingtalk.com/robot/send?access_token=REPLACE_ME'
DINGTALK_SECRET='SEC_REPLACE_ME'

# Run the reporter as root. Its HTTPS request runs as the automatically
# created traffic-dingtalk system user, which the quota firewall permits.
# Keep support_parameter_adjust_ufw_by_traffic_limit.sh updated alongside it.
# Run the quota script once after deployment to install its DNS/HTTPS rules,
# then restart traffic-usage-dingtalk-report.service to load this config.

# Match the interface and limits used by your actual quota checker. These
# fields describe usage in the message; they do not change firewall limits.
TRAFFIC_INTERFACE='eth0'

# Values here are GiB, including decimals (unlike the quota CLI's suffixes).
# Empty limits are reported as "unlimited"; remaining bytes stop at zero.
UPLOAD_LIMIT_GIB='180'
DOWNLOAD_LIMIT_GIB=''
TOTAL_LIMIT_GIB=''

# First send occurs at service startup; subsequent sends wait this interval.
# INTERVAL_SECONDS='10800'
